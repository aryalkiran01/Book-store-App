# Server Configuration
PORT=4000
NODE_ENV=production

# Database (MongoDB Connection URI)
MONGO_URI=mongodb://127.0.0.1:27017/book_review_app_db

# Security - Set a strong, randomly generated secret for JWT tokens
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production

# Frontend Client URL & Allowed Origins (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com

# Media & Storage Directory
UPLOADS_DIR=uploads/

# Payment Gateways (Khalti & eSewa)
KHALTI_TEST_MODE=true
KHALTI_SECRET_KEY=
KHALTI_INITIATE_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/

ESEWA_TEST_MODE=true
ESEWA_PRODUCT_CODE=your_esewa_product_code_or_EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_INITIATE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# Database Seeding (Set to true only in development/staging environments if dummy data is needed)
SEED_DB=false

# Initial Administrator Provisioning (Optional - alternatively use 'npm run create:admin')
# When starting a fresh production database, these credentials will securely provision the first admin account.
INITIAL_ADMIN_EMAIL=admin@your-production-domain.com
INITIAL_ADMIN_PASSWORD=your_strong_random_admin_password_min_8_chars
INITIAL_ADMIN_USERNAME=Administrator
